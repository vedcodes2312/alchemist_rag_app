              "path": ["api", "book", "info"]
            },
            "description": "Returns document slug ('the-alchemist'), title, embedding dimension (384), indexed chunk count (303), and readiness flag."
          }
        }
      ]
    },
    {
      "name": "Chat & RAG",
      "item": [
        {
          "name": "Ask Question — Personal Legend (Grounded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is a Personal Legend according to Melchizedek?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Submits a literary question. Performs 384-d semantic embedding, pgvector cosine similarity retrieval, and Gemini 3.8 Flash answer generation with citations."
          }
        },
        {
          "name": "Ask Question — Crystal Merchant (Grounded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Who is the crystal merchant and what is his lifelong dream?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Queries the character arc of the crystal merchant in Tangier."
          }
        },
        {
          "name": "Ask Question — Guardrail Test (Out-of-Domain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How do I build a nuclear fusion rocket engine?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Demonstrates strict hallucination prevention: returns status 'INSUFFICIENT_EVIDENCE' with polite refusal."
          }
        },
        {
          "name": "Ask Question with Session Threading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What happens next to Santiago after he leaves the crystal shop?\",\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Appends conversation turns to an existing Supabase chat session thread."
          }
        }
      ]
