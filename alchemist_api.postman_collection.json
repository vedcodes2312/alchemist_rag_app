      "key": "sessionId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "Liveness Probe (GET /api/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Quick liveness check returning service name, status, and timestamp."
          }
        },
        {
          "name": "Deep Health Probe (GET /api/health?deep=true)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health?deep=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"],
              "query": [
                {
                  "key": "deep",
                  "value": "true"
                }
              ]
            },
            "description": "Comprehensive diagnostics probing Supabase database connectivity, pgvector readiness, and SentenceTransformer embedding service status."
          }
        },
        {
          "name": "Book Metadata & Index Readiness (GET /api/book/info)",
          "request": {
            "method": "GET",
            "header": [],
