# ==============================================================================
# Alchemist AI — Environment Configuration Example
# Copy appropriate sections to backend/.env, frontend/.env, and embedding-service/.env
# NEVER commit actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase (Database & pgvector)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-only secret key (service_role); NEVER expose to frontend or clients
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Generation Model (Gemini API)
# Server-only secret key; obtain from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Local Python Embedding Service
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# Optional locally, required in production (sent as X-API-Key header)
EMBEDDING_SERVICE_API_KEY=

# RAG & Retrieval Parameters
EMBEDDING_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=30000
RETRIEVAL_TOP_K=5
# Minimum cosine similarity threshold (default 0.30 is an untuned placeholder)
SIMILARITY_THRESHOLD=0.30
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
MAX_QUESTION_LENGTH=500
MAX_EXCERPT_CHARS=800
RATE_LIMIT_PER_MINUTE=20
BOOK_DOCUMENT_SLUG=the-alchemist

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Proxied by Vite dev server to http://localhost:3001 in development
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Embedding Service Configuration (embedding-service/.env)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Optional locally; when set, requests must pass this value via X-API-Key header
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_MAX_BATCH=64
EMBEDDING_MAX_TEXT_CHARS=4000
